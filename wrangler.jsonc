{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drakor-indo",
  "main": "worker.js",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "rules": [{"type": "Text", "globs": ["**/*.html"], "fallthrough": true}],
  "observability": {"enabled": true, "traces": {"enabled": true}}
}
