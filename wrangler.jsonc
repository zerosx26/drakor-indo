{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drakor-indo",
  "main": "worker.js",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.html"
      ],
      "fallthrough": true
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "routes": [
    {
      "pattern": "drakor.zerosarcade.com",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CATALOG",
      "id": "f8d1610a483f44fcaea49660688d5b4c"
    }
  ],
  "triggers": {
    "crons": [
      "0 20 * * *"
    ]
  },
  "workflows": [
    {
      "name": "drakor-catalog-daily-sync",
      "binding": "CATALOG_SYNC",
      "class_name": "DailyCatalogSync",
      "concurrency": {
        "limit": 1
      }
    }
  ]
}
